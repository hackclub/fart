{
  "name": "fart",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.ts",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'server/**/*.ts' vite.config.ts",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'server/**/*.ts' vite.config.ts",
    "postinstall": "node patches/apply.js",
    "dev:server": "node --watch server/index.ts"
  },
  "dependencies": {
    "@tracespace/core": "5.0.0-alpha.0",
    "@tracespace/identify-layers": "5.0.0-alpha.0",
    "@tracespace/parser": "5.0.0-alpha.0",
    "dompurify": "3.4.17",
    "dxf-viewer": "1.0.49",
    "fzstd": "0.1.1",
    "highlight.js": "11.12.0",
    "libarchive-wasm": "1.2.0",
    "marked": "18.1.1",
    "occt-import-js": "0.0.23",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.16"
  },
  "devDependencies": {
    "@types/node": "25.3.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react-swc": "4.2.3",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "allowScripts": {
    "@swc/core": true,
    "esbuild": true
  }
}

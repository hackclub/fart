# A GitHub token raises the API limit from 60 to 5,000 requests an hour.
# Use a fine-grained token with "Public repositories (read-only)" access and nothing else.
GITHUB_TOKEN=

# Optional
PORT=3000
# In-memory cache for GitHub responses, in MB.
CACHE_MB=256
# How many models may wait for the converter at once.
CONVERT_QUEUE_LIMIT=10
# Disk space for converted models before the oldest are deleted, in MB.
CONVERT_STORE_MB=4096
# Where converted models are kept (default: <tmp>/fart-conversions).
CONVERT_DIR=
# Path to step2glb if it isn't on PATH.
STEP2GLB_PATH=

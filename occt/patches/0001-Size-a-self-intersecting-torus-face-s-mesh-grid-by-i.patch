From: Liam Newbill <98195512+destroyer796@users.noreply.github.com>
Date: Fri, 20 Nov 2026 16:37:05 -0500
Subject: [PATCH 1/3] Size a self-intersecting torus face's mesh grid by its
 real u-circle radius

BRepMesh_TorusRangeSplitter sized the u steps (and the aspect-ratio floor on
the u count) by R + r. On a self-intersecting torus (R < r) the u-circles near
the spindle tip are far smaller than that, so a thin face there got hundreds of
thousands of interior nodes that Delaunay insertion took many minutes on, e.g.
a 10.9 m torus trimmed to a 52 mm sliver in a 144 mm Onshape export got 408k
nodes. Those tori now use the largest |R + r cos v| over the face's v range.
Ordinary tori are unchanged.

diff --git a/src/BRepMesh/BRepMesh_TorusRangeSplitter.cxx b/src/BRepMesh/BRepMesh_TorusRangeSplitter.cxx
index 36955316..4e5841cd 100644
--- a/src/BRepMesh/BRepMesh_TorusRangeSplitter.cxx
+++ b/src/BRepMesh/BRepMesh_TorusRangeSplitter.cxx
@@ -18,6 +18,32 @@
 
 //=================================================================================================
 
+namespace
+{
+//! Returns the largest radius |R + r * cos(v)| of the u-circles over [theVMin, theVMax].
+//! On a self-intersecting torus (R < r) this can be far smaller than R + r, for example on a
+//! thin face near the spindle tip.
+Standard_Real maxUCircleRadius(const Standard_Real R,
+                               const Standard_Real r,
+                               const Standard_Real theVMin,
+                               const Standard_Real theVMax)
+{
+  const auto contains = [&](const Standard_Real theAngle) {
+    return Ceiling((theVMin - theAngle) / (2. * M_PI)) * 2. * M_PI + theAngle <= theVMax;
+  };
+  if (contains(0.))
+  {
+    return R + r;
+  }
+  Standard_Real aRadius = Max(Abs(R + r * Cos(theVMin)), Abs(R + r * Cos(theVMax)));
+  if (contains(M_PI))
+  {
+    aRadius = Max(aRadius, Abs(R - r));
+  }
+  return aRadius;
+}
+} // namespace
+
 Handle(IMeshData::ListOfPnt2d) BRepMesh_TorusRangeSplitter::GenerateSurfaceNodes(
   const IMeshTools_Parameters& theParameters) const
 {
@@ -44,7 +70,9 @@ Handle(IMeshData::ListOfPnt2d) BRepMesh_TorusRangeSplitter::GenerateSurfaceNodes
   Dv                         = aDiffV / (nbV + 1);
 
   Standard_Real       Du;
-  const Standard_Real ru = R + r;
+  // Sizing the u steps by R + r on a self-intersecting torus gave thin faces near its spindle
+  // tip hundreds of thousands of nodes, so those use the real u-circle radius over the face.
+  const Standard_Real ru = R < r ? maxUCircleRadius(R, r, aRangeV.first, aRangeV.second) : R + r;
   if (ru > 1.e-16)
   {
     Du = GCPnts_TangentialDeflection::ArcAngularStep(ru,
@@ -66,7 +94,7 @@ Handle(IMeshData::ListOfPnt2d) BRepMesh_TorusRangeSplitter::GenerateSurfaceNodes
   }
 
   Standard_Integer nbU = Max((Standard_Integer)(aDiffU / Du), 2);
-  nbU                  = Max(nbU, (Standard_Integer)(nbV * aDiffU * R / (aDiffV * r) / 5.));
+  nbU = Max(nbU, (Standard_Integer)(nbV * aDiffU * (R < r ? ru : R) / (aDiffV * r) / 5.));
   Du                   = aDiffU / (nbU + 1);
 
   const Handle(NCollection_IncAllocator) aTmpAlloc =
